#!/usr/bin/env bash
set -eu

# ── Package manager ──────────────────────────────────────────────────────────
# Swap this one variable to migrate: pnpm | npm | yarn | bun
PM="pnpm"

is_git_submodule_path() {
  local file_path="$1"
  local index_entry
  index_entry="$(git ls-files --stage -- "$file_path" || true)"
  [[ "$index_entry" == 160000\ * ]]
}

staged_list="$(mktemp)"
trap 'rm -f "$staged_list"' EXIT

git diff --cached --name-only --diff-filter=ACM -z >"$staged_list"

if [[ ! -s "$staged_list" ]]; then
  echo "[pre-commit] no staged files found, skipping"
  exit 0
fi

has_non_submodule_files=false

while IFS= read -r -d '' file; do
  if is_git_submodule_path "$file"; then
    echo "[pre-commit] skipping git submodule path: $file"
    continue
  fi

  has_non_submodule_files=true

  if [[ "$file" == *.sh ]]; then
    git update-index --chmod=+x "$file"
  fi
done <"$staged_list"

if [[ "$has_non_submodule_files" != true ]]; then
  echo "[pre-commit] only git submodule paths staged, skipping"
  exit 0
fi

echo "[pre-commit] running type-check + lint..."
# Redirect stdin to prevent subcommands from blocking on read
$PM run lint-type-check < /dev/null || {
  echo "[pre-commit] ABORT: type-check or lint failed — fix errors before committing"
  exit 1
}
echo "[pre-commit] type-check + lint passed"
